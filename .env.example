# --- Meta app ---
VERIFY_TOKEN=choose-any-random-string
APP_SECRET=your-meta-app-secret
APP_ID=your-meta-app-id
GRAPH_VERSION=v21.0

# --- Server ---
PORT=3000
# Public https address of this server (ngrok / domain). Used to send result images.
PUBLIC_BASE_URL=https://your-domain-or-ngrok.example

# --- Bot behaviour ---
TRIGGER_TEXT=پرو لباس
DAILY_LIMIT_PER_USER=3
CONCURRENCY=2
FILE_TTL_HOURS=24
ENABLED_CATEGORIES=tops,bottoms,outerwear,one-piece
DEFAULT_CATEGORY=tops

# --- Try-On provider: mock | (your own, see src/tryon.js) ---
TRYON_PROVIDER=mock
